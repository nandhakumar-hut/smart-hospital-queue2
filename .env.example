# Copy to .env and edit. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=instance/hospital.db
TIMEZONE=Asia/Kolkata
SESSION_HOURS=8
# Set to 1 when serving over HTTPS
COOKIE_SECURE=0
# Seed demo data automatically when the database is empty
AUTO_SEED=1
HOST=127.0.0.1
PORT=5000
DEBUG=0
